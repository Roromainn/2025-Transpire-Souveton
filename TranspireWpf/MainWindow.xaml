<Window x:Class="TranspireWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transpire des fesses" Width="500" Height="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <UniformGrid x:Name="GrillePanel" Rows="9" Columns="9"/>
        
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Valeur Sélectionnée:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <UniformGrid x:Name="BoutonsPanel" Rows="1" Columns="9"/>
            </StackPanel>
            <TextBlock x:Name="ErreursLabel" Text="Erreurs : 0 / 3" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>