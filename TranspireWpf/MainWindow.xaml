<Window x:Class="TranspireWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transpire des fesses" Width="560" Height="680">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="ModeBorder" Grid.Row="0" BorderBrush="Gray" BorderThickness="1"
                Margin="0,0,0,10" Padding="8" Cursor="Hand" Background="#EEE"
                MouseDown="ModeBorder_MouseDown">
            <TextBlock x:Name="ModeLabel" Text="Mode: TEST "
                       HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
        </Border>

        <UniformGrid x:Name="GrillePanel" Grid.Row="1" Rows="9" Columns="9"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock Text="Valeur sélectionnée:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <UniformGrid x:Name="BoutonsPanel" Rows="1" Columns="9"/>
        </StackPanel>
    </Grid>
</Window>
