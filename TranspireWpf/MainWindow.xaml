<Window x:Class="TranspireWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transpire des fesses" Width="500" Height="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <UniformGrid x:Name="GrillePanel" Rows="9" Columns="9"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock Text="Valeur sélectionnée:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <UniformGrid x:Name="BoutonsPanel" Rows="1" Columns="9"/>
        </StackPanel>
    </Grid>
</Window>